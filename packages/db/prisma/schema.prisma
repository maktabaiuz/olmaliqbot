datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER                  // Oddiy guruh a'zosi / foydalanuvchi
  SUPER_ADMIN
  CITY_ADMIN
  MODERATOR_APPROVER    // Tasdiqlovchi
  MODERATOR_EDITOR      // To'ldiruvchi
  MODERATOR_VIEWER      // Kuzatuvchi
}

enum ListingType {
  USTA
  DOKON_OBYEKT
  MUASSASA
  TRANSPORT
}

enum ListingStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum VerificationStatus {
  VERIFIED             // ✅ Admin shaxsan ko'rishgan / Tasdiqlangan
  COMMUNITY_UNVERIFIED   // ⚠️ Xalq aytgan / Tekshirilmagan
}

enum IntentType {
  CONTACT
  SERVICE
  HOURS
  LOCATION
  PRICE
  EMERGENCY
  NOT_RELEVANT
}

enum CandidateStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CorrectionStatus {
  NEW
  APPLIED
  IGNORED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentType {
  PAYMENT
  REFUND
}

enum CategoryRequestStatus {
  PENDING
  APPROVED
  MERGED
  REJECTED
}

model City {
  id              String   @id @default(uuid())
  name            String   // Masalan: "Olmaliq"
  slug            String   @unique
  isActive        Boolean  @default(true)
  subscriptionEnd DateTime?
  planType        String   @default("STANDARD") // ASOSCHI, STANDART, KATTA_SHAHAR
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]
  landmarks       Landmark[]
  listings        Listing[]
  candidates      Candidate[]
  corrections     Correction[]
  payments        Payment[]
  categoryRequests CategoryRequest[]
  queryLogs       QueryLog[]
  emergencyNumbers EmergencyNumber[]
  cityGroups      CityGroup[]

  @@map("cities")
}

model CityGroup {
  id          String   @id @default(uuid())
  cityId      String
  city        City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  chatId      BigInt   @unique
  title       String?
  createdAt   DateTime @default(now())

  @@map("city_groups")
}

model User {
  id            String   @id @default(uuid())
  telegramId    BigInt   @unique
  name          String?
  firstName     String?
  lastName      String?
  username      String?
  phone         String?
  role          Role     @default(USER)
  cityId        String?
  city          City?    @relation(fields: [cityId], references: [id])
  passwordHash  String?
  isPasswordSet Boolean  @default(false)
  oneTimeCode   String?
  loginCode     String?
  tempPassword  String?
  knownDevices  String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reviews       Review[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique // Masalan: "gazavik"
  nameRu      String?
  nameCyrl    String?
  synonyms    String[] // ["газовщик", "газовик", "gaz ustasi"]
  description String?
  createdAt   DateTime @default(now())

  listings    Listing[]
  candidates  Candidate[]

  @@map("categories")
}

model Landmark {
  id          String   @id @default(uuid())
  cityId      String
  city        City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  name        String   // Rasmiy nom: "Korzinka"
  synonyms    String[] // Xalq nomlari: ["karzinka", "корзинка"]
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())

  primaryListings   Listing[]  @relation("PrimaryLandmark")
  serviceAreaListings Listing[] @relation("ServiceAreas")
  candidates        Candidate[]

  @@map("landmarks")
}

model Listing {
  id                  String             @id @default(uuid())
  cityId              String
  city                City               @relation(fields: [cityId], references: [id], onDelete: Cascade)
  categoryId          String
  category            Category           @relation(fields: [categoryId], references: [id])
  type                ListingType        @default(USTA)
  
  // 1-Daraja: Majburiy maydonlar
  name                String
  phone               String
  primaryLandmarkId   String
  primaryLandmark     Landmark           @relation("PrimaryLandmark", fields: [primaryLandmarkId], references: [id])

  // 2-Daraja: Muhim maydonlar
  workFrom            String?            // "08:00"
  workTo              String?            // "20:00"
  badges              String[]           // ["uyga_boradi", "24_7", "kafolat", "karta_qabul_qiladi", "zudlik_bilan"]
  serviceAreaLandmarks Landmark[]        @relation("ServiceAreas") // Ko'p-ko'pga bog'lanish

  // 3-Daraja: Ixtiyoriy maydonlar
  specificServices    String?            // "kolonka ta'miri, plita o'rnatish"
  approxPrice         String?            // Taxminiy narx
  photoFileId         String?            // Telegram file_id (mo'ljal/ish namunasi)
  description         String?

  // Tizim maydonlari
  status              ListingStatus      @default(ACTIVE)
  verification        VerificationStatus @default(COMMUNITY_UNVERIFIED)
  source              String             @default("manual") // manual, archive, group, photo
  isSponsored         Boolean            @default(false)
  sponsorUntil        DateTime?
  completenessScore   Int                @default(50) // To'liqlik foizi
  
  // Reyting hisoblash (Bayesian average)
  thumbsUpCount       Int                @default(0)
  thumbsDownCount     Int                @default(0)
  bayesianRating      Float              @default(3.0) // 1.0 - 5.0 scale

  lastVerifiedAt      DateTime           @default(now())
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  reviews             Review[]
  history             ListingHistory[]
  corrections         Correction[]

  @@unique([cityId, phone])             // Bitta shaharda bir raqam ikki marta kiritilmasin
  @@index([cityId, categoryId])
  @@index([cityId, status])
  @@map("listings")
}

model Candidate {
  id                String          @id @default(uuid())
  cityId            String
  city              City            @relation(fields: [cityId], references: [id], onDelete: Cascade)
  name              String
  phone             String?
  categoryId        String?
  category          Category?       @relation(fields: [categoryId], references: [id])
  primaryLandmarkId String?
  primaryLandmark   Landmark?       @relation(fields: [primaryLandmarkId], references: [id])
  workFrom          String?
  workTo            String?
  badges            String[]
  source            String          @default("group") // archive, group, photo
  mentionCount      Int             @default(1)
  submittedBy       String?
  status            CandidateStatus @default(PENDING)
  createdAt         DateTime        @default(now())

  @@map("candidates")
}

model Correction {
  id             String           @id @default(uuid())
  cityId         String
  city           City             @relation(fields: [cityId], references: [id], onDelete: Cascade)
  listingId      String
  listing        Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  telegramUserId BigInt
  message        String
  status         CorrectionStatus @default(NEW)
  createdAt      DateTime         @default(now())

  @@map("corrections")
}

model Application {
  id                   String            @id @default(uuid())
  fullName             String
  phone                String
  cityName             String
  groupLink            String
  groupName            String?
  groupMembersCount    Int               @default(0)
  channelLink          String?
  channelName          String?
  channelSubsCount     Int               @default(0)
  about                String?
  telegramUserId       BigInt
  isGroupAdminVerified Boolean           @default(false)
  paymentReceived      Boolean           @default(false)
  planType             String            @default("ASOSCHI")
  loginCode            String?
  tempPassword         String?
  rejectionReason      String?
  status               ApplicationStatus @default(PENDING)
  createdAt            DateTime          @default(now())

  @@map("applications")
}

model Payment {
  id          String      @id @default(uuid())
  cityId      String
  city        City        @relation(fields: [cityId], references: [id], onDelete: Cascade)
  amount      Float
  method      String      // "CARD", "PAYME", "CLICK", "STARS"
  type        PaymentType @default(PAYMENT)
  periodStart DateTime
  periodEnd   DateTime
  note        String?
  createdAt   DateTime    @default(now())

  @@map("payments")
}

model BotMessage {
  id          String   @id @default(uuid())
  key         String   @unique
  textLatin   String
  textCyrillic String
  textRussian String
  isEmergency Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@map("bot_messages")
}

model CategoryRequest {
  id            String                @id @default(uuid())
  cityId        String
  city          City                  @relation(fields: [cityId], references: [id], onDelete: Cascade)
  requestedName String
  requestedBy   String
  status        CategoryRequestStatus @default(PENDING)
  mergedIntoId  String?
  createdAt     DateTime              @default(now())

  @@map("category_requests")
}

model ListingHistory {
  id          String   @id @default(uuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  changedBy   String   // User ID or AI Agent ID
  snapshot    Json     // Full snapshot of listing state before edit
  createdAt   DateTime @default(now())

  @@map("listing_histories")
}

model QueryLog {
  id                String      @id @default(uuid())
  cityId            String
  city              City        @relation(fields: [cityId], references: [id], onDelete: Cascade)
  telegramUserId    BigInt
  rawMessage        String
  botResponse       String?     // AI yoki tizim bergan javob
  intent            IntentType  @default(SERVICE)
  categoryName      String?
  landmarkName      String?
  resolvedListingId String?
  isResolved        Boolean     @default(false)
  isComplaint       Boolean     @default(false) // 👎 bosilgan yoki shikoyat yuborilgan
  complaintReason   String?     // Shikoyat sababi (masalan: noto'g'ri nomer, javob bermadi)
  adminReply        String?     // Admin chat orqali yozgan javob matni
  adminReplyAt      DateTime?
  notifiedAt        DateTime?   // User faqat 1 marta xabardor qilinadi
  clusterKey        String?     // O'xshash so'rovlarni birlashtirish klyuchi
  createdAt         DateTime    @default(now())

  @@index([cityId, isResolved])
  @@index([cityId, isComplaint])
  @@index([telegramUserId])
  @@map("query_logs")
}

model EmergencyNumber {
  id          String   @id @default(uuid())
  cityId      String
  city        City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  key         String   // "gas_emergency", "water_dept", "power_grid"
  label       String   // "Gaz avariya", "Suv ta'minoti"
  phoneNumber String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([cityId, key])
  @@map("emergency_numbers")
}

model Review {
  id             String   @id @default(uuid())
  listingId      String
  listing        Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  telegramUserId BigInt?  // Telegram User ID for single vote rule
  isPositive     Boolean  // true = 👍, false = 👎
  comment        String?
  createdAt      DateTime @default(now())

  @@map("reviews")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  cityId      String?
  action      String   // "CREATE_LISTING", "DELETE_LANDMARK", "AI_COPILOT_ACTION"
  details     Json
  createdAt   DateTime @default(now())

  @@map("audit_logs")
}
