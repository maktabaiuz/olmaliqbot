datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER                  // Oddiy guruh a'zosi / foydalanuvchi
  SUPER_ADMIN
  CITY_ADMIN
  MODERATOR_APPROVER    // Tasdiqlovchi
  MODERATOR_EDITOR      // To'ldiruvchi
  MODERATOR_VIEWER      // Kuzatuvchi
}

enum ListingType {
  USTA
  DOKON_OBYEKT
  MUASSASA
  TRANSPORT
  ARENDA
  ZAPRAVKA
}

enum ListingStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum VerificationStatus {
  VERIFIED             // ✅ Admin shaxsan ko'rishgan / Tasdiqlangan
  COMMUNITY_UNVERIFIED   // ⚠️ Xalq aytgan / Tekshirilmagan
}

// Ko'chmas mulk arenda kategoriyalari uchun strukturaviy maydonlar
// (2026-09) — "N xonali, M dollargacha, kunlik/oylik" kabi aniq
// so'rovlarni haqiqiy filtrlash imkonini beradi.
enum RentTermType {
  KUNLIK
  OYLIK
  YILLIK
}

enum RentCurrency {
  UZS
  USD
}

enum IntentType {
  CONTACT
  SERVICE
  HOURS
  LOCATION
  PRICE
  EMERGENCY
  NOT_RELEVANT
}

enum CandidateStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CorrectionStatus {
  NEW
  APPLIED
  IGNORED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentType {
  PAYMENT
  REFUND
}

enum CategoryRequestStatus {
  PENDING
  APPROVED
  MERGED
  REJECTED
}

model City {
  id              String   @id @default(uuid())
  name            String   // Masalan: "Olmaliq"
  slug            String   @unique
  isActive        Boolean  @default(true)
  subscriptionEnd DateTime?
  planType        String   @default("STANDARD") // ASOSCHI, STANDART, KATTA_SHAHAR
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]
  landmarks       Landmark[]
  listings        Listing[]
  candidates      Candidate[]
  corrections     Correction[]
  payments        Payment[]
  categoryRequests CategoryRequest[]
  queryLogs       QueryLog[]
  emergencyNumbers EmergencyNumber[]
  cityGroups      CityGroup[]
  broadcastMessages BroadcastMessage[]

  @@map("cities")
}

model CityGroup {
  id          String   @id @default(uuid())
  cityId      String
  city        City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  chatId      BigInt   @unique
  title       String?
  createdAt   DateTime @default(now())

  featureToggles GroupFeatureToggle[]
  allowedDomains AllowedDomain[]
  inviteLinks    GroupInviteLink[]
  inviteProgress GroupInviteProgress[]

  @@map("city_groups")
}

// "Foydali botlar" bo'limi — har bir xavfsizlik/moderatsiya "botchasi"
// (so'kinish filtri, spam-link filtri va h.k.) har bir guruhda ALOHIDA
// yoqilishi/o'chirilishi mumkin (iOS sozlamalar uslubidagi tugmalar kabi) —
// bitta guruhga kerak bo'lgan narsa boshqasiga keraksiz bo'lishi mumkin.
// Qatorning O'ZI YO'Q bo'lsa — o'sha bot shu guruhda O'CHIQ deb hisoblanadi
// (standart holat: yangi guruhda hammasi o'chiq boshlanadi).
model GroupFeatureToggle {
  id          String    @id @default(uuid())
  cityGroupId String
  cityGroup   CityGroup @relation(fields: [cityGroupId], references: [id], onDelete: Cascade)
  featureKey  String    // "PROFANITY" | "SPAM_LINK" | "GAMBLING" | "SCAM" | "FLOOD" | "MANDATORY_INVITE"
  isEnabled   Boolean   @default(false)
  // Umumiy, FEATURE-GA XOS sonli sozlama (2026-10) — hozircha faqat
  // "MANDATORY_INVITE" ishlatadi ("necha kishi taklif qilish shart"),
  // boshqa botlar uchun har doim null. Har bir bot uchun alohida ustun
  // ochish o'rniga, bitta ixtiyoriy maydon — kelajakda sonli sozlamaga
  // muhtoj yangi "foydali bot" chiqsa ham shu ustun qayta ishlatiladi.
  requiredCount Int?
  // Yana ikkita umumiy, FEATURE-GA XOS sozlama (2026-10) — hozircha faqat
  // "MANDATORY_INVITE" ishlatadi: guruhdagi taklif-havola tugmasining
  // matni va rangi (Telegram'ning haqiqiy 3 ta qiymati — "primary"/
  // "success"/"danger"). MUHIM: bu yerda tugmaning o'zi URL'ni EMAS,
  // faqat MATN va RANGni belgilaydi — havolaning o'zi har doim shu
  // ANIQ foydalanuvchi uchun avtomatik yaratiladigan shaxsiy taklif
  // havolasi (GroupInviteLink) bo'lib qoladi, chunki kim kimni taklif
  // qilgani FAQAT shu orqali hisoblanadi — admin ixtiyoriy URL kiritsa,
  // hisoblash ishlamay qolgan bo'lardi.
  linkLabel       String?
  linkButtonStyle String?
  // (2026-10, real test natijasi) Admin qo'shimcha tugma QAYERGA olib
  // borishini ham belgilaydi (masalan @olmaliq_bot yoki kanal). Bu
  // TAKLIF hisoblanishiga tegishli EMAS — taklif tugmasi alohida, har
  // doim shaxsiy havolani "Ulashish" oynasi orqali yuboradi.
  linkUrl         String?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  @@unique([cityGroupId, featureKey])
  @@map("group_feature_toggles")
}

// "Majburiy taklif" (MANDATORY_INVITE) foydali boti uchun (2026-10):
// yangi qo'shilgan har bir a'zoga, admin belgilagan sondagi odamni
// taklif qilmaguncha, shu guruhda yozish TAQIQLANADI. Har bir "kutib
// turgan" a'zoga o'ziga xos (createChatInviteLink orqali yaratilgan)
// taklif havolasi beriladi — shu havola orqali qo'shilgan YANGI odamlar
// sanaladi, umumiy guruh havolasi orqali kirganlar emas (aks holda kim
// kimni taklif qilganini bilib bo'lmas edi).
model GroupInviteLink {
  id                String    @id @default(uuid())
  cityGroupId       String
  cityGroup         CityGroup @relation(fields: [cityGroupId], references: [id], onDelete: Cascade)
  inviterTelegramId BigInt    // shu havolaning egasi — kim ulashishi kerak
  inviteLink        String    @unique // Telegram'ning to'liq havola matni — chat_member yangilanishida shu orqali tanib olinadi
  createdAt         DateTime  @default(now())

  @@unique([cityGroupId, inviterTelegramId])
  @@map("group_invite_links")
}

// Har bir (guruh, yangi a'zo) juftligi uchun — nechta odam HAQIQATDA
// taklif qilib qo'shilgani va shu orqali "ochilgan"mi. Qator FAQAT
// MANDATORY_INVITE yoqilgan guruhga, feature yoqiq PAYTDA qo'shilgan
// a'zolar uchun yaratiladi — shu sabab eski, oldindan a'zo bo'lganlar
// avtomatik "mustasno" (qatori yo'q, demak cheklanmagan) hisoblanadi.
model GroupInviteProgress {
  id             String    @id @default(uuid())
  cityGroupId    String
  cityGroup      CityGroup @relation(fields: [cityGroupId], references: [id], onDelete: Cascade)
  telegramUserId BigInt    // cheklangan, "kutib turgan" yangi a'zo
  invitedCount   Int       @default(0)
  isVerified     Boolean   @default(false) // true bo'lgach cheklov butunlay olib tashlanadi
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([cityGroupId, telegramUserId])
  @@map("group_invite_progress")
}

// Admin panelidan yaratiladigan, rejalashtirilgan ommaviy xabar (broadcast) —
// bot ulangan tanlangan guruh/kanallarga o'zi belgilagan vaqtda va
// takrorlanish oralig'ida yuboriladi (apps/bot/src/queue/broadcastQueue.ts).
model BroadcastMessage {
  id                    String                 @id @default(uuid())
  cityId                String
  city                  City                   @relation(fields: [cityId], references: [id], onDelete: Cascade)
  text                  String
  photoUrls             String[]               @default([])
  targetChatIds         BigInt[]               // admin tanlagan CityGroup.chatId'lar
  linkUrl               String?                // Reklama/tashqi havola — berilsa xabar ostida tugma sifatida chiqadi
  linkLabel             String?                // Tugma matni (masalan "Kanalga o'tish")
  linkButtonStyle       String?                // Telegram Bot API'ning haqiqiy 3 ta rangi: "primary" (ko'k), "success" (yashil), "danger" (qizil)
  nextSendAt            DateTime?              // keyingi (yoki birinchi) yuborilish vaqti — null bo'lsa qayta yuborilmaydi (faqat bir martalik, allaqachon yuborilgan)
  repeatIntervalMinutes Int?                   // null = faqat bir marta; aks holda har N daqiqada
  isEnabled             Boolean                @default(true)
  lastSentAt            DateTime?
  // Oxirgi yuborishda xato bo'lsa shu yerda saqlanadi (admin panelida
  // ko'rinadi) — muvaffaqiyatli yuborilganda tozalanadi. Shu bilan admin
  // "nega yuborilmadi" deb menga murojaat qilmasdan o'zi ko'rib, tuzatadi.
  lastError             String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  sentMessages          BroadcastSentMessage[]

  @@map("broadcast_messages")
}

// Har bir (post x guruh) juftligi uchun OXIRGI yuborilgan xabarning
// message_id'sini saqlaydi — keyingi sikl kelganda O'SHA guruhdagi eski
// nusxani o'chirish uchun kerak (guruh eski postlar bilan to'lib ketmasin).
model BroadcastSentMessage {
  id          String           @id @default(uuid())
  broadcastId String
  broadcast   BroadcastMessage @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  chatId      BigInt
  messageId   Int
  sentAt      DateTime         @default(now())

  @@unique([broadcastId, chatId])
  @@map("broadcast_sent_messages")
}

// Oddiy kalit-qiymat sozlamalar ombori — admin panelidan o'zgartiriladigan,
// kodga qattiq yozilmagan qiymatlar uchun (masalan kanal/bot havolasi).
// Kelajakda boshqa shunga o'xshash sozlamalar ham shu jadvalga qo'shilishi mumkin.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// Admin panel login urinishlarini kuzatish — 5 marta xato parol kiritilsa,
// 3 kunga bloklanadi (brute-force himoyasi). telegramId bo'yicha kuzatiladi,
// shuning uchun hali User jadvalida yo'q shaxslarning urinishlari ham hisobga olinadi.
model LoginAttempt {
  telegramId    BigInt    @id
  failedCount   Int       @default(0)
  bannedUntil   DateTime?
  lastAttemptAt DateTime  @default(now())

  @@map("login_attempts")
}

model User {
  id            String   @id @default(uuid())
  telegramId    BigInt   @unique
  firstName     String?
  lastName      String?
  username      String?
  // Saytdan (Telegram tashqarisida, oddiy brauzerdan) kirish uchun admin
  // o'zi tanlagan login — Telegram'ning o'zgaruvchan `username` maydonidan
  // ATAYLAB alohida: shu orqali admin panelga t.me tashqarisidan ham
  // kirish mumkin bo'ladi (2026-09, standalone web-login).
  loginUsername String?  @unique
  phoneNumber   String?            // Moderator uchun telefon raqami
  role          Role     @default(USER)
  cityId        String?
  city          City?    @relation(fields: [cityId], references: [id])
  passwordHash  String?
  isPasswordSet Boolean  @default(false)
  oneTimeCode   String?
  loginCode     String?
  tempPassword  String?
  knownDevices  String[]
  isSuspended   Boolean  @default(false)   // Hisobni vaqtincha to'xtatish
  suspendedAt   DateTime?
  addedBy       String?                     // Kim yaratdi (User.id)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reviews         Review[]
  auditLogs       AuditLog[]
  addedListings   Listing[]    @relation("AddedByUser")
  dailyChecks     DailyCheck[]

  @@map("users")
}

model Category {
  id          String       @id @default(uuid())
  name        String       @unique // Masalan: "gazavik"
  nameRu      String?
  nameCyrl    String?
  synonyms    String[] // ["газовщик", "газовик", "gaz ustasi"]
  description String?
  objectType  ListingType? // Usta/Do'kon/Muassasa/Transport bo'yicha filtrlash uchun
  group       String?      // Masalan: "Qurilish va ta'mirlash" — kasblarni mantiqiy guruhlash uchun
  emoji       String?      // Bot javobida kategoriyaga mos ikonka (masalan santexnik -> 🚿)
  createdAt   DateTime     @default(now())

  listings    Listing[]
  candidates  Candidate[]

  @@map("categories")
}

model Landmark {
  id          String   @id @default(uuid())
  cityId      String
  city        City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  name        String   // Rasmiy nom: "Korzinka"
  synonyms    String[] // Xalq nomlari: ["karzinka", "корзинка"]
  latitude    Float?
  longitude   Float?
  // Mahalla chegarasi (2026-09) — xaritadan qo'lda chizilgan poligon,
  // [[lat,lng], [lat,lng], ...] shaklida JSON. Bo'sh (`null`) bo'lsa bu
  // oddiy nuqta-manzil (masalan "Karzinka") — mahalla EMAS. To'ldirilgan
  // bo'lsa, xaritada nuqta belgilanganda shu poligon ICHIGA tushadigan
  // nuqtalar avtomatik shu Landmark'ga bog'lanadi (qarang: packages/core
  // src/search/pointInPolygon.ts). Aniq rasmiy chegara ma'lumoti mavjud
  // emasligi sabab, dastlabki qiymatlar TAXMINIY (avtomatik generatsiya
  // qilingan) — admin xohlasa xaritada qayta chizib to'g'rilashi mumkin.
  boundary    Json?
  createdAt   DateTime @default(now())

  primaryListings   Listing[]  @relation("PrimaryLandmark")
  serviceAreaListings Listing[] @relation("ServiceAreas")
  candidates        Candidate[]

  @@index([cityId, name])
  @@map("landmarks")
}

model Listing {
  id                  String             @id @default(uuid())
  cityId              String
  city                City               @relation(fields: [cityId], references: [id], onDelete: Cascade)
  categoryId          String
  category            Category           @relation(fields: [categoryId], references: [id])
  type                ListingType        @default(USTA)
  
  // 1-Daraja: Majburiy maydonlar
  name                String
  phone               String
  primaryLandmarkId   String
  primaryLandmark     Landmark           @relation("PrimaryLandmark", fields: [primaryLandmarkId], references: [id])

  // 2-Daraja: Muhim maydonlar
  workFrom            String?            // "08:00"
  workTo              String?            // "20:00"
  badges              String[]           // ["uyga_boradi", "24_7", "kafolat", "karta_qabul_qiladi", "zudlik_bilan"]
  serviceAreaLandmarks Landmark[]        @relation("ServiceAreas") // Ko'p-ko'pga bog'lanish

  // 3-Daraja: Ixtiyoriy maydonlar
  specificServices    String?            // "kolonka ta'miri, plita o'rnatish"
  approxPrice         String?            // Taxminiy narx (erkin matn, eski/umumiy maydon)

  // Ko'chmas mulk arenda kategoriyalari uchun strukturaviy maydonlar
  // (2026-09) — faqat 6 ta arenda kategoriyasida to'ldiriladi, qolgan
  // barcha listing turlarida hamisha null. `approxPrice`dan farqli —
  // qidiruvda ANIQ raqamli filtrlash (masalan "2 xonali, 300 dollargacha")
  // uchun ishlatiladi, qarang: searchEngine.ts `rentalFilters`.
  roomCount           Int?               // Xonalar soni
  rentPrice           Int?               // Narx (raqamli, valyutasiz)
  rentPriceCurrency   RentCurrency?      // UZS yoki USD
  rentTermType        RentTermType?      // KUNLIK / OYLIK / YILLIK
  photoFileId         String?            // Telegram file_id (mo'ljal/ish namunasi)
  photoUrls           String[]           @default([]) // Ko'p-rasmli e'lonlar uchun (masalan uy arendaga) — admin panelidan yuklangan rasm URL'lari
  description         String?
  latitude            Float?             // Jonli GPS Kenglik (Xarita nuqtasi)
  longitude           Float?             // Jonli GPS Uzunlik (Xarita nuqtasi)
  // Admin Yandex Xaritadan olib joylagan tayyor havola (2026-09,
  // Zapravkalar uchun) — bot javobida yashil "📍 Lokatsiya" tugmasi shu
  // havolaga olib boradi. lat/long'dan farqli — admin koordinata
  // kiritmaydi, Yandex'ning o'zi bergan ulashish havolasini nusxalaydi.
  mapUrl              String?
  jargonSynonyms      String[]           // Mahalliy jargon / xalq atamalari ["karzinka orqasi", "карзинка", "eski bozor"]

  // Tizim maydonlari
  status              ListingStatus      @default(ACTIVE)
  verification        VerificationStatus @default(COMMUNITY_UNVERIFIED)
  source              String             @default("manual") // manual, archive, group, photo
  isSponsored         Boolean            @default(false)
  sponsorUntil        DateTime?
  // Admin har bir kategoriya ichida eng ko'pi bilan 3 ta yozuvni "1/2/3-o'rin"
  // deb belgilay oladi — "Yana ko'rish" shu tartibda birinchi bo'lib
  // ularni, keyin qolganlarini oddiy reyting bo'yicha ko'rsatadi (kelajakda
  // pullik "top joylashuv" xizmati uchun asos). Bir xil kategoriyada bir xil
  // raqam ikki marta ishlatilmasligi uchun (categoryId, priorityRank) unique —
  // Postgres'da NULL qiymatlar unique cheklovda bir-biriga to'qnashmaydi,
  // shuning uchun belgilanmagan yozuvlar soni cheklanmaydi.
  priorityRank        Int?
  completenessScore   Int                @default(50) // To'liqlik foizi
  
  // Reyting hisoblash (Bayesian average)
  thumbsUpCount       Int                @default(0)
  thumbsDownCount     Int                @default(0)
  bayesianRating      Float              @default(3.0) // 1.0 - 5.0 scale

  // Kim qo'shdi
  addedByUserId       String?            // Moderator User.id
  addedByUser         User?              @relation("AddedByUser", fields: [addedByUserId], references: [id])

  // Rozilik belgisi — usta/do'kondor ruxsat bergan
  consentGiven        Boolean            @default(false)
  consentAt           DateTime?
  consentDevice       String?            // "iPhone 13, iOS 17"
  consentIp           String?

  lastVerifiedAt      DateTime           @default(now())
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  reviews             Review[]
  history             ListingHistory[]
  corrections         Correction[]
  dailyChecks         DailyCheck[]

  @@index([cityId, phone])
  @@index([cityId, categoryId])
  @@index([cityId, status])
  @@index([primaryLandmarkId])
  @@index([cityId, bayesianRating(sort: Desc)])
  @@index([addedByUserId])
  @@unique([categoryId, priorityRank])
  @@map("listings")
}

model Candidate {
  id                String          @id @default(uuid())
  cityId            String
  city              City            @relation(fields: [cityId], references: [id], onDelete: Cascade)
  name              String
  phone             String?
  categoryId        String?
  category          Category?       @relation(fields: [categoryId], references: [id])
  primaryLandmarkId String?
  primaryLandmark   Landmark?       @relation(fields: [primaryLandmarkId], references: [id])
  workFrom          String?
  workTo            String?
  badges            String[]
  source            String          @default("group") // archive, group, photo
  mentionCount      Int             @default(1)
  submittedBy       String?
  status            CandidateStatus @default(PENDING)
  createdAt         DateTime        @default(now())

  @@map("candidates")
}

model Correction {
  id             String           @id @default(uuid())
  cityId         String
  city           City             @relation(fields: [cityId], references: [id], onDelete: Cascade)
  listingId      String
  listing        Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  telegramUserId BigInt
  message        String
  status         CorrectionStatus @default(NEW)
  createdAt      DateTime         @default(now())

  @@map("corrections")
}

model Application {
  id                   String            @id @default(uuid())
  fullName             String
  phone                String
  cityName             String
  groupLink            String
  groupName            String?
  groupMembersCount    Int               @default(0)
  channelLink          String?
  channelName          String?
  channelSubsCount     Int               @default(0)
  about                String?
  telegramUserId       BigInt
  isGroupAdminVerified Boolean           @default(false)
  paymentReceived      Boolean           @default(false)
  planType             String            @default("ASOSCHI")
  loginCode            String?
  tempPassword         String?
  rejectionReason      String?
  status               ApplicationStatus @default(PENDING)
  createdAt            DateTime          @default(now())

  @@map("applications")
}

model Payment {
  id          String      @id @default(uuid())
  cityId      String
  city        City        @relation(fields: [cityId], references: [id], onDelete: Cascade)
  amount      Float
  method      String      // "CARD", "PAYME", "CLICK", "STARS"
  type        PaymentType @default(PAYMENT)
  periodStart DateTime
  periodEnd   DateTime
  note        String?
  createdAt   DateTime    @default(now())

  @@map("payments")
}

// Bot foydalanuvchiga yuboradigan HAQIQIY shablonlar (2026-09: avval bu
// jadval admin panelidan tahrirlanar edi, lekin botning o'zi hech qachon
// bazadan o'qimasdi — tahrirlangan matn hech qachon foydalanuvchiga
// bormas edi. Endi packages/core/src/botMessages/botMessageStore.ts
// orqali botning haqiqiy xabar yuborish kodi shu jadvaldan o'qiydi,
// 60 soniyalik keshlash bilan).
model BotMessage {
  id           String   @id @default(uuid())
  key          String   @unique
  category     String   @default("OTHER") // "REPLY" | "EMERGENCY" | "OTHER"
  textLatin    String
  textCyrillic String
  textRussian  String
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@map("bot_messages")
}

model CategoryRequest {
  id            String                @id @default(uuid())
  cityId        String
  city          City                  @relation(fields: [cityId], references: [id], onDelete: Cascade)
  requestedName String
  requestedBy   String
  status        CategoryRequestStatus @default(PENDING)
  mergedIntoId  String?
  createdAt     DateTime              @default(now())

  @@map("category_requests")
}

model ListingHistory {
  id          String   @id @default(uuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  changedBy   String   // User ID or AI Agent ID
  snapshot    Json     // Full snapshot of listing state before edit
  createdAt   DateTime @default(now())

  @@map("listing_histories")
}

model QueryLog {
  id                String      @id @default(uuid())
  cityId            String
  city              City        @relation(fields: [cityId], references: [id], onDelete: Cascade)
  // Guruhdan kelgan so'rov bo'lsa shu guruhning chatId'si (2026-09,
  // "Guruhlar" bo'limidagi so'rov/javob statistikasi uchun qo'shildi) —
  // shaxsiy (DM) so'rovlarda har doim null qoladi. FAQAT shu maydon
  // qo'shilgandan KEYINGI yozuvlarda to'ldiriladi, eski tarixiy
  // yozuvlarda null (orqaga tiklab bo'lmaydi).
  chatId            BigInt?
  telegramUserId    BigInt
  rawMessage        String
  intent            IntentType  @default(SERVICE)
  categoryName      String?
  landmarkName      String?
  resolvedListingId String?
  isResolved        Boolean     @default(false)
  notifiedAt        DateTime?   // User faqat 1 marta xabardor qilinadi
  clusterKey        String?     // O'xshash so'rovlarni birlashtirish klyuchi
  confidence        Float?      // AI klassifikator ishonchlilik darajasi — chegaradosh (0.5-0.75) holatlarni kuzatish uchun
  // 2026-09-28, "Guruhlar" chuqur tahlili — bot javob berish tezligi
  // (millisekundda): xabar qabul qilingandan javob (yoki jim qolish
  // qarori) yakunlanguncha. Guruh darajasidagi texnik sog'liq ko'rsatkichi
  // (sekinlashuvni erta payqash) uchun.
  responseTimeMs    Int?
  createdAt         DateTime    @default(now())

  @@index([cityId, isResolved])
  @@index([chatId, createdAt])
  @@map("query_logs")
}

// 2026-09-28, "Guruhlar" chuqur tahlili uchun (foydalanuvchi so'radi: "nechta
// jonli odam, nechtasi faol emas", eng faol a'zolar, umumiy xabar hajmi,
// bot foydaliligi %). QueryLog FAQAT bot uchun tegishli so'rovlarni (0-qavat
// filtrdan o'tganlarini, taxminan 10%) saqlaydi — guruhning HAQIQIY umumiy
// faolligini bilish uchun BARCHA matnli xabarlar (matnisiz, faqat kim va
// qachon — shaxsiy hayotga aralashmaslik uchun ATAYLAB xabar matni
// SAQLANMAYDI) alohida, ushbu YENGIL jadvalda qayd etiladi.
model GroupMessageEvent {
  id             String   @id @default(uuid())
  chatId         BigInt
  telegramUserId BigInt
  createdAt      DateTime @default(now())

  @@index([chatId, createdAt])
  @@index([chatId, telegramUserId])
  @@map("group_message_events")
}

// 2026-09-28, "Guruhlar" chuqur tahlili uchun — yangi a'zo guruhga qachon
// qo'shilgani (Telegram'ning `new_chat_members` hodisasi orqali). "Yangi
// a'zo → birinchi so'rov" konversiyasini (botning shu guruhda qanchalik
// "topilishi/foydaliligi") hisoblash uchun kerak.
model GroupMemberJoinEvent {
  id             String   @id @default(uuid())
  chatId         BigInt
  telegramUserId BigInt
  joinedAt       DateTime @default(now())

  @@index([chatId, joinedAt])
  @@map("group_member_join_events")
}

// 2026-09-28, "Guruhlar" chuqur tahlili — a'zolar soni vaqt bo'yicha qanday
// o'zgarayotganini ko'rsatish uchun kunlik "suratlar" (snapshot). Alohida
// fon-vazifa (cron) o'rniga, admin panel "Guruhlar" ekrani ochiq turganda
// (har 20 soniyada) so'ralayotgan jonli a'zolar soni ustiga QO'SHIMCHA
// ravishda, bir martalik (kun uchun) yoziladi — arzon, qo'shimcha infra
// talab qilmaydi.
model GroupMemberSnapshot {
  id          String   @id @default(uuid())
  cityGroupId String
  date        String   // "YYYY-MM-DD", Toshkent kuni
  memberCount Int
  createdAt   DateTime @default(now())

  @@unique([cityGroupId, date])
  @@map("group_member_snapshots")
}

// 2026-09-28, "Mahalliy so'zlar lug'ati" — foydalanuvchi so'radi: bot
// guruhlardagi odamlarning HAQIQIY so'zlarini, mahalliy jargon/shevani
// DOIMIY o'qib, o'rganib borishi, va bu o'rgangan so'zlar keyinchalik
// yangi ma'lumot (kategoriya/manzil) qo'shishda foydalanilishi kerak.
//
// Haqiqiy "o'rganish" (nomzod so'zlarni topish, chastotasini hisoblash,
// qaysi kategoriya/manzil bilan bog'liqligini taxmin qilish) ALLAQACHON
// mavjud QueryLog.rawMessage'dan JONLI (talab bo'yicha, keshlangan)
// hisoblanadi — yangi xom matn saqlash SHART EMAS (aks holda maxfiylik
// izi ortadi, QueryLog allaqachon bu matnni saqlaydi). Bu jadval FAQAT
// admin biror so'z bo'yicha qaror qabul qilganini (bazaga QO'SHILDI yoki
// RAD ETILDI) eslab qolish uchun — aks holda bir xil so'z har safar
// qaytadan "yangi" bo'lib chiqib, ro'yxatni cheksiz iflos qilib turardi.
// 2026-09-28, "LIVE rejim" (foydalanuvchi aniq shunday so'radi: "hozirdan
// boshlab, har bitta user yozganini o'qib, live rejimda saqlab yursin") —
// avvalgi LearnedTermDecision (faqat qabul/rad qarorini saqlagan, o'zi
// hech narsani "o'rganmagan" holat) BUTUN nomzod hisob-kitobini o'rniga
// qo'ydi. Endi har bir kandidat so'z HAR XABAR kelganda (guruh xabar
// oqimida, botning javob berish tezligiga ta'sir qilmasdan, fon rejimida)
// shu YAGONA qatorga o'sib boruvchi (upsert) tarzda yoziladi — 10
// daqiqada bir marta so'nggi 5000 xabarni qayta skanerlash O'RNIGA.
model LearnedTermAggregate {
  id                    String    @id @default(uuid())
  cityId                String
  term                  String    // normallashtirilgan so'z/ibora

  // Bitta xabar shablonining ko'p marta qayta joylanishi bitta so'zni
  // sun'iy ravishda "chastotali" qilib ko'rsatmasligi uchun (2026-09-28
  // aniqlangan sifat muammosi) — har bir XABAR "skeleti" (o'ziga xos
  // so'zlar to'plami) shu ro'yxatga (cheklangan hajmda) yoziladi, faqat
  // YANGI skelet uchrasagina son oshadi.
  distinctSkeletonCount Int       @default(0)
  skeletonsSeen         String[]  @default([])

  sampleMessage         String
  // JSON: { "<categoryName>": count, ... } — qaysi kategoriya bilan
  // ko'proq ko'rilganini (ovoz berish orqali) bilish uchun.
  categoryVotes         Json      @default("{}")
  landmarkVotes         Json      @default("{}")

  // PENDING (hali qaror qilinmagan) | ACCEPTED | DISMISSED
  status                String    @default("PENDING")

  // Gemini'ning (faqat maslahat, qat'iy filtr EMAS) "bu haqiqiy mahalliy
  // nommi" degan bahosi — har bir so'z uchun FAQAT BIR MARTA (birinchi
  // marta chegaradan o'tganda) so'raladi, keyin doim shu saqlanadi.
  aiConfirmed           Boolean?
  aiCheckedAt           DateTime?

  firstSeenAt           DateTime  @default(now())
  lastSeenAt            DateTime  @default(now())

  @@unique([cityId, term])
  @@index([cityId, status, distinctSkeletonCount])
  @@map("learned_term_aggregates")
}

// Guruhdagi xavfsizlik-moderatsiya filtrlari (so'kinish, spam-havola,
// qimor reklamasi, firibgarlik, flud) tomonidan o'chirilgan xabarlar
// tarixi — admin panelida "kim, qachon, nima uchun" jazolangani ko'rinishi
// uchun (apps/bot/src/moderation/enforceModeration.ts).
model ModerationLog {
  id             String   @id @default(uuid())
  chatId         BigInt
  telegramUserId BigInt
  category       String   // PROFANITY | SPAM_LINK | GAMBLING | SCAM | FLOOD
  rawMessage     String
  // Admin panelida "Tahlil qil" bosilganda Gemini (URL Context) orqali
  // olingan qisqa xulosa shu yerga keshlanadi — talab bo'yicha ishlaydi
  // (avtomatik emas), shuning uchun boshida har doim bo'sh (null).
  aiAnalysis     String?
  createdAt      DateTime @default(now())

  @@index([chatId, createdAt])
  @@index([telegramUserId])
  @@map("moderation_logs")
}

// "Spam-link filtri" yoqilgan guruhda ADMIN "bu domenga ruxsat ber" deb
// qo'shgan istisnolar — masalan o'zining rasmiy do'kon sayti. Bizning o'z
// domenlarimiz (olmaliq.online, t.me/olmaliq_bot) BU JADVALGA KIRMAYDI —
// ular kodda global, doimiy ruxsat etilgan (enforceModeration.ts).
model AllowedDomain {
  id          String    @id @default(uuid())
  cityGroupId String
  cityGroup   CityGroup @relation(fields: [cityGroupId], references: [id], onDelete: Cascade)
  domain      String    // masalan "olmaliqshop.uz" yoki "instagram.com/olmaliqshop"
  createdAt   DateTime  @default(now())

  @@unique([cityGroupId, domain])
  @@map("allowed_domains")
}

// "Qimor filtri" uchun admin qo'shgan qo'shimcha taqiqlangan
// sayt/brend nomlari — GLOBAL (barcha guruhlar uchun bitta ro'yxat),
// chunki taqiqlangan qimor sayti hamma joyda taqiqlangan bo'lishi kerak,
// guruh-guruh emas. Yangi sayt yopilib, o'rniga yangisi chiqqanda,
// admin kodni o'zgartirmasdan tezda qo'sha oladi.
model GamblingKeyword {
  id        String   @id @default(uuid())
  keyword   String   @unique
  createdAt DateTime @default(now())

  @@map("gambling_keywords")
}

// MUHIM (2026-09): bu jadval avval kodda HECH QAYERDA ishlatilmagan edi
// (5 ta qattiq kodlangan "mahalliy raqam" — gaz/suv/elektr/issiqlik/
// hokimiyat — AppSetting orqali alohida saqlanadi, ular o'zgarishsiz
// qoladi). Endi admin so'roviga ko'ra shu jadval JONLANTIRILDI:
// "Mahalliy raqamlar" ekranida admin CHEKSIZ sonli QO'SHIMCHA mahalliy
// dispecher/xizmat raqami qo'sha oladi (masalan "Mahalla raisi", "Tozalik
// xizmati") — har biri o'z mahalliy jargon so'zlari bilan. Bunday raqam
// so'ralganda bot HECH QANDAY "DARHOL bunday qiling" shablonisiz, FAQAT
// so'ralgan ma'lumotni (nomi + telefon) qaytaradi — bular hayotiy xavf
// emas, oddiy ma'lumot-so'rov.
model EmergencyNumber {
  id          String   @id @default(uuid())
  cityId      String
  city        City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  key         String   // "gas_emergency", "water_dept", "power_grid"
  label       String   // "Gaz avariya", "Suv ta'minoti"
  phoneNumber String
  jargonWords String[] @default([]) // odamlar qanday so'rashi mumkin ("mahalla raisi", "raisga qongiroq")
  // MUHIM (2026-09, uchinchi bosqich): admin AI yordamida mavzuga mos
  // emoji bilan tayyorlangan xabar shablonlarini tanlab, saqlab qo'yishi
  // mumkin ("{phone}" — telefon raqami o'rniga qo'yiladigan joy belgisi).
  // Bo'sh bo'lsa, standart (🏢 nomi + 📞 raqam) format ishlatiladi.
  messageTemplate String?
  // Reklama/havola tugmasi — BroadcastMessage'dagi bilan AYNAN bir xil
  // maydonlar va Telegram Bot API rang qiymatlari (primary/success/danger).
  linkUrl         String?
  linkLabel       String?
  linkButtonStyle String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([cityId, key])
  @@map("emergency_numbers")
}

model Review {
  id             String   @id @default(uuid())
  listingId      String
  listing        Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  telegramUserId BigInt?  // Telegram User ID for single vote rule
  isPositive     Boolean  // true = 👍, false = 👎
  comment        String?
  createdAt      DateTime @default(now())

  @@map("reviews")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  cityId      String?
  action      String   // "CREATE_LISTING", "SUSPEND_MODERATOR", "VERIFY_LISTING"
  details     Json
  deviceInfo  String?  // "iPhone 13, iOS 17, Safari"
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([cityId, createdAt])
  @@map("audit_logs")
}

model DailyCheck {
  id          String    @id @default(uuid())
  cityId      String
  listingId   String
  listing     Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  checkedBy   String?   // User.id — kim tekshirdi
  checker     User?     @relation(fields: [checkedBy], references: [id])
  isVerified  Boolean   @default(false)
  verifiedAt  DateTime?
  checkDate   String    // "2026-08-13" — bir kunda qayta yaratilmasin
  createdAt   DateTime  @default(now())

  @@unique([listingId, checkDate])
  @@index([cityId, checkDate])
  @@map("daily_checks")
}

model ChatMessage {
  id             String   @id @default(uuid())
  telegramUserId BigInt
  senderType     String   // "USER" | "BOT_AI" | "BOT_SEARCH" | "ADMIN"
  text           String
  isComplaint    Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([telegramUserId, createdAt])
  @@map("chat_messages")
}


// Majburiy obuna (2026-10): /start bosganda va har bir shaxsiy xabarda bot
// foydalanuvchi shu ro'yxatdagi BARCHA yoqilgan kanal/guruhlarga obuna
// ekanini tekshiradi. Botning o'zi har birida admin bo'lishi shart
// (getChatMember faqat shunda ishlaydi). Bot bitta umumiy botligi uchun
// shaharga bog'lanmagan.
model RequiredChannel {
  id        String   @id @default(uuid())
  title     String
  url       String
  chatId    String?  // "@kanal" yoki "-100..." — getChatMember uchun
  sortOrder Int      @default(0)
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("required_channels")
}
